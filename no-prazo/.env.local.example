# URL e chave pública do projeto Supabase. Use a chave anon/publishable, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_BASE_PATH=/NoPrazo

# OAuth Supabase configurado no projeto (sem formulário de login customizado).
SUPABASE_AUTH_PROVIDER=google

# Acesso server-to-server ao serviço interno de SLA; não use NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:8000
SLA_API_KEY=replace-with-a-long-random-secret
