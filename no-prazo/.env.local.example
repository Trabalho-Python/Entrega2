# URL e chave pública do ambiente local do Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
NEXT_PUBLIC_BASE_PATH=/NoPrazo
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Email/password local, sem OAuth do Google.
SUPABASE_AUTH_PROVIDER=email

# Acesso server-to-server ao serviço interno de SLA.
API_INTERNAL_URL=http://127.0.0.1:8000
SLA_API_KEY=replace-with-a-long-random-secret
